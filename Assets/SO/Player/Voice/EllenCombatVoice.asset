  _groups:
  - _cue: 0
    _chance: 0.18
    _lines:
    - _subtitle: 等一下，我换弹。
      _audioResourceId:
    - _subtitle: 啧，又打空了。
      _audioResourceId:
  - _cue: 1
    _chance: 0.12
    _lines:
    - _subtitle: 嘶……这下真疼。
      _audioResourceId:
    - _subtitle: 糟了，被盯上了。
      _audioResourceId:
  - _cue: 2
    _chance: 0.25
    _lines:
    - _subtitle: 好，少一个麻烦。
      _audioResourceId:
    - _subtitle: 解决了，能歇会儿吗？
      _audioResourceId:
  - _cue: 3
    _chance: 0.65
    _lines:
    - _subtitle: 三个？今天效率还行。
      _audioResourceId:
    - _subtitle: 这下能早点收工了吧。
      _audioResourceId:
  - _cue: 4
    _chance: 0.25
    _lines:
    - _subtitle: 又得上班了……我来了。
      _audioResourceId:
