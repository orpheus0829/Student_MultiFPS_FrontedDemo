  - _cue: 1
    _chance: 0.12
    _lines:
    - _subtitle: 受伤了，还能继续。
      _audioResourceId:
    - _subtitle: 先稳住，不急。
      _audioResourceId:
  - _cue: 2
    _chance: 0.25
    _lines:
    - _subtitle: 目标肃清。
      _audioResourceId:
    - _subtitle: 下一个。
      _audioResourceId:
  - _cue: 3
    _chance: 0.65
    _lines:
    - _subtitle: 三人已倒，继续推进。
      _audioResourceId:
    - _subtitle: 节奏已经掌握了。
