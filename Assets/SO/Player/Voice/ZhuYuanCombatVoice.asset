  _groups:
  - _cue: 0
    _chance: 0.18
    _lines:
    - _subtitle: 换弹，留意周围！
      _audioResourceId:
    - _subtitle: 我正在换弹，马上继续！
      _audioResourceId:
  - _cue: 1
    _chance: 0.12
    _lines:
    - _subtitle: 中弹了，先找掩护！
      _audioResourceId:
    - _subtitle: 我还能战斗，注意侧面！
      _audioResourceId:
  - _cue: 2
    _chance: 0.25
    _lines:
    - _subtitle: 威胁解除！
      _audioResourceId:
    - _subtitle: 目标倒下，继续警戒。
      _audioResourceId:
  - _cue: 3
    _chance: 0.65
    _lines:
    - _subtitle: 三个威胁已排除，推进！
      _audioResourceId:
    - _subtitle: 威胁清除，继续警戒！
      _audioResourceId:
  - _cue: 4
    _chance: 0.25
    _lines:
    - _subtitle: 返回战场，重新警戒！
